{
  "stoplist": [
    "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday",
    "January", "February", "March", "April", "May", "June", "July", "August",
    "September", "October", "November", "December",
    "Google", "Sheets", "Sheet", "Gmail", "Xero", "Square", "WhatsApp", "Drive",
    "Portland", "Oregon", "London", "Bristol", "Seattle", "Manchester",
    "Street", "Avenue", "Road", "Lane", "Drive", "Court", "Place", "Boulevard",
    "Way", "Market", "River", "King", "Willow", "Station", "Baker", "Pine", "Park",
    "Oak", "Division", "Every", "Once", "After", "Then", "When", "This", "That",
    "Sales", "Tax", "Bank", "Invoice", "Client", "Monthly", "Weekly", "Daily",
    "PDF", "CSV", "Notes", "Please", "Thanks", "Hello", "Dear", "From", "Subject",
    "Draft", "Approve", "Claude", "Make", "Friday", "Morning", "Today"
  ],
  "patterns": {
    "email": ["[A-Za-z0-9._%+\\-]+@[A-Za-z0-9.\\-]+\\.[A-Za-z]{2,}"],
    "phone": [
      "\\+\\d{1,3}(?:[\\s\\-.]?\\(?\\d{1,4}\\)?){2,5}",
      "(?:\\(\\d{3}\\)|\\b\\d{3})[\\s.\\-]\\d{3}[\\s.\\-]\\d{4}\\b",
      "\\b0\\d{2,4}(?:[\\s\\-]\\d{3,4}){2}\\b"
    ],
    "amount": [
      "(?:USD|GBP|EUR|CAD)\\s+\\d{1,3}(?:,\\d{3})*(?:\\.\\d{2})?",
      "[$£€]\\s?\\d{1,3}(?:,\\d{3})*(?:\\.\\d{2})?",
      "\\b\\d{1,3}(?:,\\d{3})*(?:\\.\\d{2})?\\s+dollars\\b"
    ],
    "address": [
      "\\b\\d{1,5}\\s+(?:[A-Z][A-Za-z]*\\.?\\s+){1,6}(?:Street|St|Avenue|Ave|Road|Rd|Boulevard|Blvd|Lane|Ln|Drive|Dr|Way|Court|Ct|Place|Pl)\\b(?:,\\s*[A-Z][a-z]+(?:\\s+[A-Z][a-z]+)*)?(?:,\\s*[A-Z]{2})?(?:\\s+\\d{5}(?:-\\d{4})?)?(?:\\s+[A-Z]{1,2}\\d[A-Z\\d]?\\s*\\d[A-Z]{2})?"
    ],
    "name_title": [
      "\\b(?:Mr|Mrs|Ms|Mx|Dr|Prof)\\.?\\s+[A-Z][a-z]+(?:\\s+[A-Z][a-z]+){0,2}\\b"
    ],
    "name_greeting": [
      "\\b(?:Hi|Hello|Dear|Hey)\\s+[A-Z][a-z]{2,}\\b"
    ]
  },
  "name_pair": "\\b[A-Z][a-z]{2,}(?:-[A-Z][a-z]+)?\\s+[A-Z][a-z]{2,}(?:-[A-Z][a-z]+)?\\b"
}
