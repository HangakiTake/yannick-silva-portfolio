# Copy to .env (never commit .env). Leave FLEET_MODE=mock until every key below is filled in.
FLEET_MODE=mock                 # mock = recorded responses in fixtures/, live = real APIs
SEND_ENABLED=no                 # n8n only sends WhatsApp/email when this is exactly "yes"
FLEET_APP_DIR=/opt/fleet-compliance-assistant

# DVLA Vehicle Enquiry Service (tax + MOT summary)
DVLA_API_KEY=
# DVSA MOT History API (OAuth2 client credentials + API key, all sent by DVSA on registration)
DVSA_CLIENT_ID=
DVSA_CLIENT_SECRET=
DVSA_TENANT_ID=
DVSA_API_KEY=
# DocuSign eSignature REST API (demo base URI: https://demo.docusign.net)
DOCUSIGN_BASE_URI=https://demo.docusign.net
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_ACCESS_TOKEN=          # from a JWT grant; tokens last about 1 hour, see HANDOVER.md
# Alert recipients (used by n8n only; never written to logs or messages)
ALERT_EMAIL_FROM=
ALERT_EMAIL_PRIMARY=
ALERT_EMAIL_ESCALATION=
ALERT_WHATSAPP_PRIMARY=         # format whatsapp:+447...
ALERT_WHATSAPP_ESCALATION=
TWILIO_WHATSAPP_FROM=           # sandbox: whatsapp:+14155238886
